{
  "name": "Community-Engagement",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 4 }] }
      },
      "name": "Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.APIFY_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "hashtags": ["recruitment", "hiring", "hr", "futureofwork"],
          "resultsLimit": 20,
          "searchType": "hashtag"
        }
      },
      "name": "Find Posts to Engage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [400, 300],
      "notes": "Find recent posts in recruitment niche"
    },
    {
      "parameters": {
        "functionCode": "const posts = $input.first().json;\n// Filter: high engagement but not from competitors\nconst filtered = posts.filter(p => \n  (p.likesCount > 50 || p.commentsCount > 5) &&\n  !p.ownerUsername?.includes('competitor1') &&\n  !p.ownerUsername?.includes('competitor2')\n).slice(0, 5);\nreturn filtered.map(p => ({ json: p }));"
      },
      "name": "Filter Relevant Posts",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "={{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 300,
          "messages": [
            {
              "role": "user",
              "content": "You are Barry Prost, Co-Founder of Rent a Recruiter. Write a genuine, insightful comment for this post. NOT salesy. Add value, share experience, or ask a good question. Max 2 sentences.\n\nPost by {{$json.ownerUsername}}: {{$json.caption}}\n\nReturn just the comment text, nothing else."
            }
          ]
        }
      },
      "name": "Generate Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [800, 300],
      "notes": "Claude generates a genuine, non-spammy comment"
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{$json.content[0].text}}", "operation": "isNotEmpty" }]
        }
      },
      "name": "Has Comment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_CHANNEL_ID}}",
        "text": "💬 ENGAGEMENT OPPORTUNITY\n\nPost by @{{$json.ownerUsername}}: {{$json.caption}}\n\nSuggested comment:\n{{$json.content[0].text}}\n\nApprove to post this comment:"
      },
      "name": "Ask Approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1200, 200],
      "notes": "Send to Slack for approval before commenting"
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { message: 'Comment skipped — no approval' } }];"
      },
      "name": "Skip",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Every 4 Hours": { "main": [[{ "node": "Find Posts to Engage", "type": "main", "index": 0 }]] },
    "Find Posts to Engage": { "main": [[{ "node": "Filter Relevant Posts", "type": "main", "index": 0 }]] },
    "Filter Relevant Posts": { "main": [[{ "node": "Generate Comment", "type": "main", "index": 0 }]] },
    "Generate Comment": { "main": [[{ "node": "Has Comment?", "type": "main", "index": 0 }]] },
    "Has Comment?": {
      "main": [
        [{ "node": "Ask Approval", "type": "main", "index": 0 }],
        [{ "node": "Skip", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true
}
