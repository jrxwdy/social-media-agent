{
  "name": "Blog-to-Social",
  "nodes": [
    {
      "parameters": {
        "url": "={{$env.RAR_BLOG_RSS}}",
        "options": {}
      },
      "name": "RSS Trigger",
      "type": "n8n-nodes-base.rssFeedTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "Triggers when new blog post published on rentarecruiter.com"
    },
    {
      "parameters": {
        "url": "={{$json.link}}",
        "options": {}
      },
      "name": "Fetch Article",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Fetch full article content"
    },
    {
      "parameters": {
        "functionCode": "const html = $input.first().json.body;\nconst text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nreturn [{ json: { text: text.substring(0, 8000) } }];"
      },
      "name": "Extract Text",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "={{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 2000,
          "messages": [
            {
              "role": "user",
              "content": "You are Barry Prost, Co-Founder of Rent a Recruiter. Voice: confident, direct, data-driven, slightly contrarian. You challenge recruitment industry norms.\n\nWrite 3 social posts from this blog article:\n\nArticle: {{$json.text}}\n\n1. LINKEDIN POST (150-200 words): Lead with a contrarian insight or surprising stat. End with a question. No hashtags.\n2. INSTAGRAM CAPTION (100-150 words): Punchy, visual, story-driven. End with CTA. 5 hashtags.\n3. FACEBOOK POST (100 words): Conversational, link to article, ask for opinions.\n\nReturn JSON: {\"linkedin\": \"...\", \"instagram\": \"...\", \"facebook\": \"...\"}"
            }
          ]
        }
      },
      "name": "Generate Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 300],
      "notes": "Claude generates 3 platform-native posts"
    },
    {
      "parameters": {
        "functionCode": "const resp = JSON.parse($input.first().json.content[0].text);\nconst items = ['linkedin', 'instagram', 'facebook'].map(platform => ({\n  json: {\n    platform,\n    text: resp[platform],\n    source: 'blog-repurpose'\n  }\n}));\nreturn items;"
      },
      "name": "Split Platforms",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MIXPOST_URL}}/api/v1/posts",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.MIXPOST_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "text": "={{$json.text}}",
          "platforms": ["={{$json.platform}}"],
          "scheduled_at": "={{new Date(Date.now() + (Math.random() * 7 * 24 * 60 * 60 * 1000)).toISOString()}}",
          "status": "pending_approval"
        }
      },
      "name": "Queue to Mixpost",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1250, 300],
      "notes": "Schedule post for random time in next 7 days, pending approval"
    },
    {
      "parameters": {
        "workflowId": "slack-approval-bot"
      },
      "name": "Trigger Approval",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1450, 300],
      "notes": "Trigger Slack approval workflow"
    }
  ],
  "connections": {
    "RSS Trigger": {
      "main": [[{ "node": "Fetch Article", "type": "main", "index": 0 }]]
    },
    "Fetch Article": {
      "main": [[{ "node": "Extract Text", "type": "main", "index": 0 }]]
    },
    "Extract Text": {
      "main": [[{ "node": "Generate Posts", "type": "main", "index": 0 }]]
    },
    "Generate Posts": {
      "main": [[{ "node": "Split Platforms", "type": "main", "index": 0 }]]
    },
    "Split Platforms": {
      "main": [[{ "node": "Queue to Mixpost", "type": "main", "index": 0 }]]
    },
    "Queue to Mixpost": {
      "main": [[{ "node": "Trigger Approval", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "saveManualExecutions": true,
    "callerWorkflows": []
  },
  "active": true
}
