{
  "name": "Trend-Discovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      },
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.APIFY_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "hashtags": ["recruitment", "hiring", "hr", "futureofwork", "talentacquisition", "recruiter", "hiringtips", "employerbranding"],
          "resultsLimit": 50,
          "searchType": "hashtag"
        }
      },
      "name": "Scrape Trending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Apify scrapes trending IG content by recruitment hashtags"
    },
    {
      "parameters": {
        "functionCode": "const items = $input.first().json;\nconst scored = items.map(item => {\n  const engagement = (item.likes || 0) + (item.comments || 0) * 3;\n  const hoursSince = (Date.now() - new Date(item.timestamp)) / 3600000;\n  const recencyBoost = Math.max(0, 48 - hoursSince) / 48;\n  const score = engagement * recencyBoost;\n  return { json: { ...item, score, engagement }};\n}).sort((a, b) => b.json.score - a.json.score).slice(0, 10);\nreturn scored;"
      },
      "name": "Score & Rank",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300],
      "notes": "Score by engagement + recency, take top 10"
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "={{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 1500,
          "messages": [
            {
              "role": "user",
              "content": "You are Barry Prost, Co-Founder of Rent a Recruiter.\n\nHere are the top 10 trending recruitment posts on Instagram:\n{{$json}}\n\nFor each post, extract:\n1. The core topic/insight\n2. Why it worked (engagement driver)\n3. How Barry could recreate this with his own voice\n\nReturn JSON array: [{\"topic\": \"...\", \"why_it_worked\": \"...\", \"barry_angle\": \"...\", \"format\": \"reel|carousel|static\"}]"
            }
          ]
        }
      },
      "name": "Analyze Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 300],
      "notes": "Claude analyzes WHY content worked + Barry's angle"
    },
    {
      "parameters": {
        "functionCode": "const trends = JSON.parse($input.first().json.content[0].text);\nreturn trends.map(t => ({ json: { ...t, source: 'trend-discovery' } }));"
      },
      "name": "Split Trends",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MIXPOST_URL}}/api/v1/posts",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.MIXPOST_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "text": "={{$json.barry_angle}}",
          "platforms": ["instagram"],
          "status": "pending_approval",
          "metadata": {
            "source": "trend-discovery",
            "original_topic": "={{$json.topic}}",
            "format": "={{$json.format}}"
          }
        }
      },
      "name": "Queue Trend Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Scrape Trending", "type": "main", "index": 0 }]] },
    "Scrape Trending": { "main": [[{ "node": "Score & Rank", "type": "main", "index": 0 }]] },
    "Score & Rank": { "main": [[{ "node": "Analyze Trends", "type": "main", "index": 0 }]] },
    "Analyze Trends": { "main": [[{ "node": "Split Trends", "type": "main", "index": 0 }]] },
    "Split Trends": { "main": [[{ "node": "Queue Trend Posts", "type": "main", "index": 0 }]] }
  },
  "active": true
}
