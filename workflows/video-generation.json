{
  "name": "Video-Generation",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 12 }] }
      },
      "name": "Every 12 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.APIFY_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "hashtags": ["recruitment", "hiring", "hr", "careeradvice"],
          "resultsLimit": 20,
          "searchType": "hashtag",
          "mediaType": "video"
        }
      },
      "name": "Find Trending Videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [400, 300],
      "notes": "Scrape trending Reels/TikToks in recruitment niche"
    },
    {
      "parameters": {
        "functionCode": "const videos = $input.first().json;\nconst top = videos\n  .filter(v => v.playCount > 1000)\n  .sort((a, b) => b.playCount - a.playCount)\n  .slice(0, 3);\nreturn top.map(v => ({ json: v }));"
      },
      "name": "Top 3 Videos",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "={{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 2000,
          "messages": [
            {
              "role": "user",
              "content": "You are Barry Prost, Co-Founder of Rent a Recruiter.\n\nHere's a trending video in recruitment:\n{{$json.caption}}\n\nViews: {{$json.playCount}}\n\nWrite a Seedance 2.0 video prompt to recreate this concept with Barry's voice. The prompt must:\n1. Describe the scene (office, whiteboard, talking head, etc.)\n2. Specify the mood (confident, direct, slightly humorous)\n3. Include the key text overlays\n4. Be 30-60 seconds long\n5. End with a CTA to follow Rent a Recruiter\n\nReturn JSON: { \"prompt\": \"...\", \"text_overlays\": [\"...\"], \"duration\": 45, \"format\": \"reel|tiktok|short\" }"
            }
          ]
        }
      },
      "name": "Generate Video Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [800, 300],
      "notes": "Claude writes a Seedance prompt for video generation"
    },
    {
      "parameters": {
        "url": "https://fal.ai/api/fal-ai/seedance-2",
        "method": "POST",
        "headers": {
          "Authorization": "Key {{$env.FAL_KEY}}",
          "Content-Type": "application/json"
        },
        "body": {
          "prompt": "={{$json.prompt}}",
          "duration": "={{$json.duration}}",
          "aspect_ratio": "9:16"
        }
      },
      "name": "Generate Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1000, 300],
      "notes": "Seedance 2.0 generates video from prompt (~$3.63/video)"
    },
    {
      "parameters": {
        "functionCode": "return [{ json: {\n  video_url: $input.first().json.video.url,\n  prompt: $input.first()._parent.json.prompt,\n  format: $input.first()._parent.json.format,\n  text_overlays: $input.first()._parent.json.text_overlays,\n  source: 'video-generation'\n}}];"
      },
      "name": "Extract Video",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MIXPOST_URL}}/api/v1/posts",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.MIXPOST_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "media_url": "={{$json.video_url}}",
          "platforms": ["={{$json.format}}"],
          "status": "pending_approval",
          "metadata": {
            "source": "video-generation",
            "prompt": "={{$json.prompt}}"
          }
        }
      },
      "name": "Queue Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1400, 300],
      "notes": "Queue generated video for approval + publishing"
    }
  ],
  "connections": {
    "Every 12 Hours": { "main": [[{ "node": "Find Trending Videos", "type": "main", "index": 0 }]] },
    "Find Trending Videos": { "main": [[{ "node": "Top 3 Videos", "type": "main", "index": 0 }]] },
    "Top 3 Videos": { "main": [[{ "node": "Generate Video Prompt", "type": "main", "index": 0 }]] },
    "Generate Video Prompt": { "main": [[{ "node": "Generate Video", "type": "main", "index": 0 }]] },
    "Generate Video": { "main": [[{ "node": "Extract Video", "type": "main", "index": 0 }]] },
    "Extract Video": { "main": [[{ "node": "Queue Video", "type": "main", "index": 0 }]] }
  },
  "active": true
}
