{
  "name": "Slack-Approval-Bot",
  "nodes": [
    {
      "parameters": {
        "trigger": "webhook",
        "httpMethod": "POST",
        "path": "approval"
      },
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_CHANNEL_ID}}",
        "blocks": [
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*New Post for Review*\n\n{{$json.text}}\n\n*Platform:* {{$json.platform}}\n*Source:* {{$json.source}}"
            }
          },
          {
            "type": "actions",
            "elements": [
              {
                "type": "button",
                "text": { "type": "plain_text", "text": "✅ Approve" },
                "action_id": "approve",
                "style": "primary",
                "value": "{{$json}}"
              },
              {
                "type": "button",
                "text": { "type": "plain_text", "text": "✏️ Edit" },
                "action_id": "edit",
                "value": "{{$json}}"
              },
              {
                "type": "button",
                "text": { "type": "plain_text", "text": "❌ Reject" },
                "action_id": "reject",
                "style": "danger",
                "value": "{{$json}}"
              }
            ]
          }
        ]
      },
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Send post to Slack with Approve/Edit/Reject buttons"
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{$json.action}}", "operation": "equals", "value2": "approve" }]
        }
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MIXPOST_URL}}/api/v1/posts/{{$json.post_id}}/publish",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.MIXPOST_API_TOKEN}}",
          "Content-Type": "application/json"
        }
      },
      "name": "Publish Now",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 200],
      "notes": "Publish approved post immediately"
    },
    {
      "parameters": {
        "url": "={{$env.MIXPOST_URL}}/api/v1/posts/{{$json.post_id}}",
        "method": "PATCH",
        "headers": {
          "Authorization": "Bearer {{$env.MIXPOST_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "status": "rejected"
        }
      },
      "name": "Mark Rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 400],
      "notes": "Mark rejected in Mixpost"
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { message: 'Post rejected. You can recreate from the original in Mixpost.' } }];"
      },
      "name": "Log Rejection",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "Approval Webhook": { "main": [[{ "node": "Send to Slack", "type": "main", "index": 0 }]] },
    "Send to Slack": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]] },
    "Approved?": {
      "main": [
        [{ "node": "Publish Now", "type": "main", "index": 0 }],
        [{ "node": "Mark Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Mark Rejected": { "main": [[{ "node": "Log Rejection", "type": "main", "index": 0 }]] }
  },
  "active": true
}
