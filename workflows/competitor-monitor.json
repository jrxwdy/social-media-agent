{
  "name": "Competitor-Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "weeksInterval": 1 }] }
      },
      "name": "Every Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "Weekly competitor monitoring every Monday 9am"
    },
    {
      "parameters": {
        "functionCode": "const handles = $env.COMPETITOR_IG_HANDLE.split(',');\nreturn handles.map(h => ({ json: { handle: h.trim() } }));"
      },
      "name": "Split Handles",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {{$env.APIFY_API_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": {
          "usernames": ["={{$json.handle}}"],
          "resultsLimit": 10,
          "searchType": "user"
        }
      },
      "name": "Scrape Competitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [650, 300],
      "notes": "Scrape last 10 posts from each competitor"
    },
    {
      "parameters": {
        "functionCode": "const posts = $input.first().json;\nconst summary = posts.map(p => ({\n  handle: p.ownerUsername,\n  caption: p.caption?.substring(0, 200),\n  likes: p.likesCount,\n  comments: p.commentsCount,\n  type: p.type,\n  timestamp: p.timestamp,\n  url: p.url\n}));\nconst totalLikes = summary.reduce((s, p) => s + (p.likes || 0), 0);\nconst totalComments = summary.reduce((s, p) => s + (p.comments || 0), 0);\nconst topPost = summary.sort((a, b) => b.likes - a.likes)[0];\nreturn [{ json: {\n  competitor: summary[0]?.handle,\n  posts: summary,\n  stats: { totalLikes, totalComments, avgLikes: Math.round(totalLikes/summary.length), topPost }\n}}];"
      },
      "name": "Summarize",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": {
          "x-api-key": "={{$env.ANTHROPIC_API_KEY}}",
          "anthropic-version": "2023-06-01",
          "content-type": "application/json"
        },
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 1000,
          "messages": [{
            "role": "user",
            "content": "Analyze this competitor's Instagram activity for the week:\n{{$json}}\n\nIn 3 bullet points:\n1. What content themes are they leaning into?\n2. What's working (high engagement)?\n3. What gaps exist that Rent a Recruiter could fill?\n\nReturn plain text, no markdown."
          }]
        }
      },
      "name": "Analyze Competitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_CHANNEL_ID}}",
        "text": "📊 WEEKLY COMPETITOR REPORT\n\n{{$json.content[0].text}}"
      },
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1250, 300],
      "notes": "Weekly competitor report to Slack"
    }
  ],
  "connections": {
    "Every Monday": { "main": [[{ "node": "Split Handles", "type": "main", "index": 0 }]] },
    "Split Handles": { "main": [[{ "node": "Scrape Competitor", "type": "main", "index": 0 }]] },
    "Scrape Competitor": { "main": [[{ "node": "Summarize", "type": "main", "index": 0 }]] },
    "Summarize": { "main": [[{ "node": "Analyze Competitor", "type": "main", "index": 0 }]] },
    "Analyze Competitor": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  },
  "active": true
}
